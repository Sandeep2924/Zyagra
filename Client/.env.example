# ── Zyagra Client — Environment Variables ────────────────────────────────────
# Copy this file to .env in Zyagra/Client/ and fill in values.
# On Vercel: Settings → Environment Variables → add each one.

# Your Render backend URL (fill in after deploying Server)
# In LOCAL dev: leave empty "" so Vite proxy forwards to localhost:5001
# In PRODUCTION: set to your actual Render URL
VITE_API_URL=https://zyagra-api.onrender.com

# Razorpay publishable key (KEY ID only — never put the secret here)
VITE_RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx

# ─────────────────────────────────────────────────────────────────────────────
# HOW TO DEPLOY ON VERCEL
# ─────────────────────────────────────────────────────────────────────────────
# 1. Push repo to GitHub
# 2. Go to https://vercel.com → Add New Project → Import your repo
# 3. Settings:
#      Framework Preset : Vite
#      Root Directory   : Zyagra/Client
#      Build Command    : npm run build
#      Output Directory : dist
# 4. Add environment variables above under Settings → Environment Variables
# 5. Click Deploy — Vercel gives you a URL like:
#      https://zyagra.vercel.app
#    Paste that URL as CLIENT_URL in your Server .env on Render
#
# ── IMPORTANT: add vercel.json for React Router SPA routing ──────────────────
# Without it, refreshing any route (e.g. /products) gives a 404.
# The vercel.json file is included in this zip — place it in Zyagra/Client/
