# ── Zyagra Server — Environment Variables ────────────────────────────────────
# Copy this file to .env in Zyagra/Server/ and fill in the values.
# On Render: paste each key-value pair into Dashboard → Environment → Add Variable

# MongoDB Atlas connection string
# Get from: https://cloud.mongodb.com → Your Cluster → Connect → Drivers
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/zyagra?retryWrites=true&w=majority

# Secret for signing JWTs — use a long random string, never share it
# Generate one: https://randomkeygen.com → Fort Knox Passwords
JWT_SECRET=your_super_secret_jwt_key_here_min_32_chars

# Port Render assigns automatically — leave as is
PORT=5001

# Razorpay (get from https://dashboard.razorpay.com → Settings → API Keys)
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# URL of your Vercel frontend (fill in after deploying Client)
# Used to configure CORS so only your frontend can call the backend
CLIENT_URL=https://zyagra.vercel.app

# ─────────────────────────────────────────────────────────────────────────────
# HOW TO DEPLOY ON RENDER
# ─────────────────────────────────────────────────────────────────────────────
# 1. Push your entire repo to GitHub
# 2. Go to https://render.com → New → Web Service
# 3. Connect your GitHub repo
# 4. Settings:
#      Root Directory : Zyagra/Server
#      Build Command  : npm install
#      Start Command  : node server.js
#      Node Version   : 18
# 5. Add every variable above under Environment → Add Variable
# 6. Click Deploy — Render gives you a URL like:
#      https://zyagra-api.onrender.com
#    Paste that URL as VITE_API_URL in your Client .env
